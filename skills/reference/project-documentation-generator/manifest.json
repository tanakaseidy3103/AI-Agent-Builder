{
  "format_version": "1",
  "id": "project-documentation-generator",
  "name": "Project Documentation Generator",
  "description": "Generates a factual README draft from a project's files: languages, detected frameworks, run/test scripts, top-level structure and test locations. Use when a repository lacks documentation or onboarding notes.",
  "version": "1.0.0",
  "kind": "code",
  "tools": ["Read", "Bash", "Write"],
  "dependencies": [],
  "permissions": ["compute", "read-input-files"],
  "input_schema": {
    "type": "object",
    "properties": {
      "files": {"type": "object", "additionalProperties": {"type": "string"}},
      "project_name": {"type": "string"}
    },
    "required": ["files"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "markdown": {"type": "string"},
      "languages": {"type": "object"},
      "frameworks": {"type": "array", "items": {"type": "string"}},
      "scripts": {"type": "object"},
      "test_locations": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["markdown", "languages", "frameworks", "scripts", "test_locations"]
  },
  "execution": {"runtime": "python3.12", "entrypoint": "scripts/main.py", "timeout_seconds": 10, "memory_mb": 256},
  "tests": {"framework": "unittest", "path": "tests"},
  "compatibility": ["claude-code", "codex", "cursor"],
  "origin": "reference"
}
