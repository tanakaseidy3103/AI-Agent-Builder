# Public Demo Mode (apps/api/app/demo). Copy to apps/api/.env.demo and fill in. No secret belongs in the frontend.
# The demo REFUSES to start unless it has its own database (name containing "demo") and its own storage folder.
DEMO_DATABASE_URL=postgresql+psycopg://aab:<postgres-password>@127.0.0.1:5434/aab_demo
DEMO_STORAGE_DIR=data-demo
# exact origin of the published frontend, e.g. https://<project>.pages.dev (comma separated; never "*")
DEMO_ALLOWED_ORIGINS=https://<project>.pages.dev
# Host headers accepted: the Quick Tunnel hostname pattern plus local testing
DEMO_ALLOWED_HOSTS=*.trycloudflare.com,localhost,127.0.0.1
DEMO_MODEL=qwen2.5-coder:latest
DEMO_MAX_PROMPT_CHARS=1000
DEMO_MAX_REQUEST_BYTES=64000
DEMO_MAX_CONCURRENT_GENERATIONS=1
DEMO_QUEUE_MAX=5
DEMO_GENERATIONS_PER_SESSION=3
DEMO_SESSIONS_PER_IP_PER_HOUR=5
DEMO_RATE_LIMIT_PER_MINUTE=240
DEMO_SANDBOX_CONCURRENCY=2
DEMO_JOB_TIMEOUT_S=1200
DEMO_DATA_TTL_HOURS=24
DEMO_SEED_EXAMPLES=true

# Not DEMO_-prefixed: read from the process environment (in production the systemd EnvironmentFile, see
# docs/DEPLOY.md) or from apps/api/.env.
# OLLAMA_BASE_URL=http://127.0.0.1:11434        # or https://model.<domain> behind deploy/ollama-proxy.Caddyfile.example
# OLLAMA_API_KEY=                                # empty for a local model; the proxy's key for a remote one
# SANDBOX_IMAGE=python:3.12-slim
